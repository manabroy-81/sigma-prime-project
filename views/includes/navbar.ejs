<style>
  .search-btn{
    background-color: rgb(247, 3, 133);
    color: #FFF;
    border: none;
    display: flex;
    align-items: center;
    border-radius:0 20px 20px 0;
    padding: 0 1rem 0 1rem;
    font-size: 1.3rem;
    box-shadow:0 10px 30px rgb(241, 233, 233);
  }
  .search-btn:hover{
    background-color:rgb(247, 3, 133);
    color: #FFF;
  }
  .search-btn i{
    color: #FFF;
    margin-right:0.5rem ;
  }
  .search-input{
    border-radius: 20px 0 0 20px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1.3rem;
    opacity: 0.7;
    box-shadow:0 10px 30px rgb(241, 233, 233);
  }
  .add-cottage{
    font-size: 15px;
    font-weight: 540;
    border-radius: 0 20px 0 20px;
  }

</style>
<nav class="navbar navbar-expand-sm bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand fs-3" href="/listing "
      ><i id="mountain-city" class="fa-solid fa-mountain-city"></i
    ></a>
    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav">
        <a class="nav-link " href="/listing">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
         <input class="form-control me-2 search-input" type="search" placeholder="Search destinations"/>
         <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <button class="btn btn-outline-warning btn-sm add-cottage">
          <a class="nav-link" href="/listing/new">Add New Cottage </a>
        </button>
        <% if(!currUser){ %>
        <a class="nav-link " href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if(currUser){ %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
