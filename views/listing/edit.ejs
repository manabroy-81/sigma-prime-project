<body class="new-background">
  <% layout("/layouts/boilerplate.ejs") %>
  <div class="row mt-3">
    <div class="col-8 offset-2 create-new">
      <h3 class="Cottage">Edit Your Cottage</h3>
      <form
        method="POST"
        action="/listing/<%=listing._id%>?_method=PUT"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-lebel">Title:</label>
          <i class="fa-solid fa-pen"></i>
          <input
            type="text"
            name="listing[title]"
            value="<%=listing.title %>"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title Looks good!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-lebel">Description:</label>
          <i class="fa-solid fa-file-lines"></i>
          <textarea name="listing[description]" class="form-control" required>
<%= listing.description %></textarea
          >
        </div>
        <div class="mb-3 ">
          <h3 class="fw-bold opacity-75 fs-5 ">Original Image</h3>
          <img class="card-image-edit " src="<%=originalImageUrl%>" alt="image" />
        </div>
        <div class="mb-3">
          <label for="image" class="form-lebel">Upload new Image:</label>
          <i class="fa-solid fa-image"></i>
          <input type="file" name="listing[image]" class="form-control" />
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lebel">Price:</label>
            <i class="fa-solid fa-indian-rupee-sign"></i>
            <input
              type="number"
              name="listing[price]"
              value="<%=listing.price %>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label class="country" class="form-lebel">Country:</label>
            <i class="fa-solid fa-earth-asia"></i>
            <input
              type="text"
              name="listing[country]"
              value="<%=listing.country%>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please choose a valid country</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-lebel">Location</label>
          <i class="fa-solid fa-location-dot"></i>
          <input
            type="text"
            name="listing[location]"
            value="<%=listing.location %>"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please choose a valid location</div>
        </div>
        <button class="btn btn-dark">Edit</button>
      </form>
    </div>
  </div>
  <br />
</body>
