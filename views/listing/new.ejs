<body class="new-background">
  <% layout("/layouts/boilerplate.ejs") %>
  <div class="row mt-3 mb-3">
    <div class="col-8 offset-2 create-new">
      <h3 class="Cottage">Ctreate New Stay</h3>
      <form
        method="POST"
        action="/listing"
        novalidate
        class="needs-validation mt-3"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title:</label>
          <i class="fa-solid fa-pen"></i>
          <input
            type="text"
            class="form-control"
            name="listing[title]"
            placeholder="Add title"
            required
          />
          <div class="valid-feedback">Title Looks good!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-lebel">Description:</label>
          <i class="fa-solid fa-file-lines"></i>
          <textarea
            type="text"
            class="form-control"
            name="listing[description]"
            required
          ></textarea>
        </div>
        <div class="invalid-feedback">Please enter a discription</div>
        <div class="mb-3">
          <label for="image" class="form-lebel">Upload Image:</label>
          <i class="fa-solid fa-image"></i>
          <input type="file" class="form-control" name="listing[image]" />
          required
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lebel">Price:</label>
            <i class="fa-solid fa-indian-rupee-sign"></i>
            <input
              name="listing[price]"
              placeholder="1,000"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-lebel">Country:</label>
            <i class="fa-solid fa-earth-asia"></i>
            <input
              type="text"
              name="listing[country]"
              placeholder="India"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please choose a valid country</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-lebel">Location:</label>
          <i class="fa-solid fa-location-dot"></i>
          <input
            type="text"
            name="listing[location]"
            placeholder="Darjjeling"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please choose a valid location</div>
        </div>
        <button class="btn btn-dark">Add New Info</button>
      </form>
    </div>
  </div>
</body>
